{
  "manifest_version": 3,
  "name": "TLDR",
  "description": "Summarises webpages according to the user profile",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
      "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; object-src 'none'; child-src 'none'"
    },
  "sandbox": {
      "pages": ["sandbox/program-runner.html"]
    },
  "permissions": ["scripting", "activeTab", "storage", "sidePanel", "unlimitedStorage"],
  "host_permissions": [
      "<all_urls>"
    ]

}
